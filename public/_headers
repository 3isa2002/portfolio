# Cloudflare Pages headers. The build-time share images have no file extension
# (Next's opengraph-image convention), so name their type for crawlers.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/projects/*/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400
