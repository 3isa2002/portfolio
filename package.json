{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "content": "velite build --strict",
    "images": "node scripts/optimize-images.mts",
    "prepare:assets": "pnpm content && pnpm images",
    "dev": "pnpm prepare:assets && next dev",
    "build": "pnpm prepare:assets && next build && node scripts/fix-segment-prefetch.mts",
    "start": "npx serve@14 out",
    "lint": "eslint .",
    "typecheck": "pnpm content && next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "cmdk": "^1.1.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "postprocessing": "^6.39.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0",
    "velite": "^0.4.0"
  },
  "devDependencies": {
    "@shikijs/rehype": "^4.6.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  }
}
